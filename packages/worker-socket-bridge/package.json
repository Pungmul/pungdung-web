{
  "name": "@pungdung/worker-socket-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Worker-backed STOMP socket bridge with RPC and runtime fallback",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./react/testing": "./src/react/testing/index.tsx",
    "./protocol": "./src/protocol/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "build:workers": "node ./scripts/build-workers.mjs",
    "build:workers:watch": "node ./scripts/build-workers.mjs --watch",
    "docs:sync": "node ./scripts/sync-docs.mjs",
    "predocs:dev": "node ./scripts/sync-docs.mjs",
    "predocs:build": "node ./scripts/sync-docs.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@stomp/stompjs": "7.2.1",
    "sockjs-client": "1.6.1",
    "use-sync-external-store": "1.6.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/sockjs-client": "1.5.4",
    "@types/react": "19.2.17",
    "esbuild": "0.21.5",
    "mermaid": "11.15.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  }
}
