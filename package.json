{
  "name": "pungdung-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate:web-fcm-sw": "node scripts/generate-firebase-sw.mjs --app web",
    "build:workers": "pnpm --filter @pungdung/worker-socket-bridge build:workers -- --outdir web/public",
    "build:workers:watch": "pnpm --filter @pungdung/worker-socket-bridge build:workers:watch -- --outdir web/public",
    "predev:web": "pnpm run generate:web-fcm-sw && pnpm run build:workers",
    "dev:web": "pnpm --filter @pungdung/web dev",
    "dev:native": "pnpm --filter @pungdung/native start",
    "dev:mock:web": "pnpm run generate:web-fcm-sw && pnpm run build:workers && pnpm --filter @pungdung/web dev:mock",
    "prebuild:web": "cross-env NODE_ENV=production pnpm run generate:web-fcm-sw && cross-env NODE_ENV=production pnpm run build:workers",
    "build:web": "pnpm --filter @pungdung/web build",
    "start:web": "pnpm --filter @pungdung/web start",
    "lint:web": "pnpm --filter @pungdung/web lint",
    "test:web": "pnpm --filter @pungdung/web test",
    "test:run:web": "pnpm --filter @pungdung/web test:run",
    "test:ui:web": "pnpm --filter @pungdung/web test:ui",
    "test:coverage:web": "pnpm --filter @pungdung/web test:coverage",
    "prebuild:native": "pnpm --filter @pungdung/native prebuild",
    "start:native": "pnpm --filter @pungdung/native start",
    "ios:native": "pnpm --filter @pungdung/native ios",
    "android:native": "pnpm --filter @pungdung/native android",
    "prebuild": "pnpm run prebuild:web",
    "build": "pnpm run build:web",
    "dev": "pnpm run dev:web",
    "start": "pnpm run start:web",
    "lint": "pnpm run lint:web",
    "test": "pnpm run test:web",
    "test:run": "pnpm run test:run:web",
    "test:ui": "pnpm run test:ui:web",
    "test:coverage": "pnpm run test:coverage:web",
    "typecheck:workers": "pnpm --filter @pungdung/worker-socket-bridge exec tsc --project tsconfig.workers.json --noEmit"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "typescript": "5.6.2"
  },
  "packageManager": "pnpm@11.7.0"
}
